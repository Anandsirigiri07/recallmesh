# ==============================================================================
# RECALLMESH Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local custom configuration.
# DO NOT commit real secrets or API keys to version control.

# Target Selector: 'local' (default) or 'cloud'
# Keeps local and cloud configs separated so you can switch safely without overwriting.
FALKORDB_TARGET=local

# ------------------------------------------------------------------------------
# 1. Local Docker FalkorDB Configuration (Default)
# ------------------------------------------------------------------------------
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH_NAME=recallmesh

# ------------------------------------------------------------------------------
# 2. FalkorDB Cloud Configuration (Active when FALKORDB_TARGET=cloud)
# ------------------------------------------------------------------------------
# Replace these placeholders with your private FalkorDB Cloud endpoint credentials:
FALKORDB_CLOUD_HOST=your-instance.falkordb.cloud
FALKORDB_CLOUD_PORT=6379
FALKORDB_CLOUD_USERNAME=default
FALKORDB_CLOUD_PASSWORD=your_cloud_password_here
FALKORDB_CLOUD_SSL=true
FALKORDB_CLOUD_GRAPH=recallmesh

# ------------------------------------------------------------------------------
# 3. Evidence File Storage Settings
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
EVIDENCE_MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# 4. Service Host & Port Settings
# ------------------------------------------------------------------------------
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
